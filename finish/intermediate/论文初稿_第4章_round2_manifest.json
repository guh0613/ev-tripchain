    },
    {
      "segment_index": 36,
      "paragraph_index": 36,
      "chunk_index": 1,
      "chars": 98,
      "preview": "$$w_{\\text{voltage}} = \\frac{1}{1 + \\exp\\left(-\\frac{m - \\delta_{\\text{safe}}}{\\"
    },
    {
      "segment_index": 37,
